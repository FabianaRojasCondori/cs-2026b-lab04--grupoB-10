@startuml
title <size:24>Deployment View: EcoRecicla AQP - Producción</size>\n<size:24>Despliegue de EcoRecicla AQP en el servidor VPS único de producción.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.DispositivodelUsuario, "Dispositivo del Usuario", $type="Android / iOS / Chrome / Firefox", $descr="Teléfono móvil inteligente o navegador web de escritorio.", $tags="", $link="") {
  Container(Producción.DispositivodelUsuario.Aplicacionwebprogresiva_1, "Aplicacion web progresiva", $techn="JavaScript / Service Worker / IndexedDB", $descr="Interfaz por rol para vecinos, recicladores y administracion; permite registro local y sincronizacion al recuperar conexion.", $tags="", $link="")
}

Deployment_Node(Producción.ServidorVPSenlaNube, "Servidor VPS en la Nube", $type="Ubuntu 24.04 LTS, 2 vCPU, 4 GB RAM", $descr="Servidor virtual de bajo costo para el MVP (DigitalOcean / Linode / AWS Lightsail).", $tags="", $link="") {
  Deployment_Node(Producción.ServidorVPSenlaNube.DockerCompose, "Docker Compose", $type="Docker 27", $descr="Orquestación de servicios locales en el servidor único.", $tags="", $link="") {
    Container(Producción.ServidorVPSenlaNube.DockerCompose.APIEcoRecicla_1, "API EcoRecicla", $techn="Python / Django REST Framework", $descr="Monolito modular con servicios de aplicacion y adaptadores.", $tags="", $link="")
    Container(Producción.ServidorVPSenlaNube.DockerCompose.Workerdenotificaciones_1, "Worker de notificaciones", $techn="Python / Celery", $descr="Ejecuta tareas de notificacion y reintentos en segundo plano.", $tags="", $link="")
    ContainerDb(Producción.ServidorVPSenlaNube.DockerCompose.Basededatos_1, "Base de datos", $techn="PostgreSQL", $descr="Una instancia con esquemas solicitudes, rutas, puntos y reportes; cada modulo accede solo a su esquema.", $tags="", $link="")
    ContainerQueue(Producción.ServidorVPSenlaNube.DockerCompose.Colaycache_1, "Cola y cache", $techn="Redis", $descr="Mantiene tareas pendientes y datos temporales de sesiones y cache.", $tags="", $link="")
  }

}

Rel(Producción.DispositivodelUsuario.Aplicacionwebprogresiva_1, Producción.ServidorVPSenlaNube.DockerCompose.APIEcoRecicla_1, "Invoca los servicios del sistema", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(Producción.ServidorVPSenlaNube.DockerCompose.APIEcoRecicla_1, Producción.ServidorVPSenlaNube.DockerCompose.Basededatos_1, "Lee y escribe mediante el esquema de cada modulo", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.ServidorVPSenlaNube.DockerCompose.APIEcoRecicla_1, Producción.ServidorVPSenlaNube.DockerCompose.Colaycache_1, "Encola notificaciones y accede a cache", $techn="Redis protocol/TCP", $tags="", $link="")
Rel(Producción.ServidorVPSenlaNube.DockerCompose.Workerdenotificaciones_1, Producción.ServidorVPSenlaNube.DockerCompose.Colaycache_1, "Consume tareas pendientes", $techn="Redis protocol/TCP", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml